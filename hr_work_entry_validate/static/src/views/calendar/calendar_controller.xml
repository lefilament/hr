<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="hr_work_entry_validate.calendar.controlButtons"
        t-inherit="web.CalendarController.controlButtons"
        t-inherit-mode="primary"
    >
        <xpath expr="." position="inside">
            <button
                t-if="displayValidateButton"
                class="btn btn-secondary"
                t-on-click="validate"
                title="Validate period work entries"
                t-att-disabled="!anyDraft"
            >Validate period</button>
        </xpath>
    </t>
</templates>
